        "default": "./dist/define/segmented-control.js"
      },
      "./segment": {
        "types": "./dist/define/segment.d.ts",
        "default": "./dist/define/segment.js"
      },
      "./tooltip": {
        "types": "./dist/define/tooltip.d.ts",
        "default": "./dist/define/tooltip.js"
      },
      "./text-field": {
        "types": "./dist/define/text-field.d.ts",
        "default": "./dist/define/text-field.js"
      },
      "./search-field": {
        "types": "./dist/define/search-field.d.ts",
        "default": "./dist/define/search-field.js"
      },
      "./textarea": {
        "types": "./dist/define/textarea.d.ts",
        "default": "./dist/define/textarea.js"
      },
      "./number-field": {
        "types": "./dist/define/number-field.d.ts",
        "default": "./dist/define/number-field.js"
      },
      "./checkbox": {
        "types": "./dist/define/checkbox.d.ts",
        "default": "./dist/define/checkbox.js"
      },
      "./switch": {
        "types": "./dist/define/switch.d.ts",
        "default": "./dist/define/switch.js"
      },
      "./radio-group": {
        "types": "./dist/define/radio-group.d.ts",
        "default": "./dist/define/radio-group.js"
      },
      "./radio": {
        "types": "./dist/define/radio.d.ts",
        "default": "./dist/define/radio.js"
      },
      "./slider": {
        "types": "./dist/define/slider.d.ts",
        "default": "./dist/define/slider.js"
      },
      "./range-slider": {
        "types": "./dist/define/range-slider.d.ts",
        "default": "./dist/define/range-slider.js"
      },
      "./select": {
        "types": "./dist/define/select.d.ts",
        "default": "./dist/define/select.js"
      },
      "./option": {
        "types": "./dist/define/option.d.ts",
        "default": "./dist/define/option.js"
      },
      "./combobox": {
        "types": "./dist/define/combobox.d.ts",
        "default": "./dist/define/combobox.js"
      }
    }
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "vscode.html-data.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate.ts",
    "wire": "node scripts/wire.ts"
  },
  "dependencies": {
    "@station/behaviors": "workspace:*",
    "@station/icons": "workspace:*",
    "@station/tokens": "workspace:*",
    "atomico": "^2.2.0"
  },
  "customElements": "custom-elements.json",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "preact": "^11.0.0",
    "solid-js": "^1.9.15",
