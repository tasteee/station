        "types": "./dist/define/button.d.ts",
        "default": "./dist/define/button.js"
      },
      "./icon-button": {
        "types": "./dist/define/icon-button.d.ts",
        "default": "./dist/define/icon-button.js"
      },
      "./toggle-button": {
        "types": "./dist/define/toggle-button.d.ts",
        "default": "./dist/define/toggle-button.js"
