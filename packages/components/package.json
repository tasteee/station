{
  "name": "@station/components",
  "version": "0.0.0",
  "description": "Station web components, built with Atomico.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/define/*",
    "./dist/define/*",
    "./src/index.ts",
    "./dist/index.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./icon": "./src/define/icon.ts",
    "./kbd": "./src/define/kbd.ts",
    "./elements": {
      "types": "./types/elements.d.ts"
    },
    "./react": {
      "types": "./types/react.d.ts"
    },
    "./preact": {
      "types": "./types/preact.d.ts"
    },
    "./solid": {
      "types": "./types/solid.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-data.json": "./vscode.html-data.json",
    "./button": "./src/define/button.ts",
    "./icon-button": "./src/define/icon-button.ts",
    "./toggle-button": "./src/define/toggle-button.ts",
    "./button-group": "./src/define/button-group.ts",
    "./toolbar": "./src/define/toolbar.ts",
    "./segmented-control": "./src/define/segmented-control.ts",
    "./segment": "./src/define/segment.ts",
    "./tooltip": "./src/define/tooltip.ts",
    "./text-field": "./src/define/text-field.ts",
    "./search-field": "./src/define/search-field.ts",
    "./textarea": "./src/define/textarea.ts",
    "./number-field": "./src/define/number-field.ts",
    "./checkbox": "./src/define/checkbox.ts",
    "./switch": "./src/define/switch.ts",
    "./radio-group": "./src/define/radio-group.ts",
    "./radio": "./src/define/radio.ts",
    "./slider": "./src/define/slider.ts",
    "./range-slider": "./src/define/range-slider.ts",
    "./select": "./src/define/select.ts",
    "./option": "./src/define/option.ts",
    "./combobox": "./src/define/combobox.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./icon": {
        "types": "./dist/define/icon.d.ts",
        "default": "./dist/define/icon.js"
      },
      "./kbd": {
        "types": "./dist/define/kbd.d.ts",
        "default": "./dist/define/kbd.js"
      },
      "./elements": {
        "types": "./types/elements.d.ts"
      },
      "./react": {
        "types": "./types/react.d.ts"
      },
      "./preact": {
        "types": "./types/preact.d.ts"
      },
      "./solid": {
        "types": "./types/solid.d.ts"
      },
      "./vue": {
        "types": "./types/vue.d.ts"
      },
      "./svelte": {
        "types": "./types/svelte.d.ts"
      },
      "./custom-elements.json": "./custom-elements.json",
      "./vscode.html-data.json": "./vscode.html-data.json",
