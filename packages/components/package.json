{
  "name": "@station/components",
  "version": "0.0.0",
  "description": "Station web components, built with Atomico.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/define/*",
    "./dist/define/*",
    "./src/index.ts",
    "./dist/index.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./icon": "./src/define/icon.ts",
    "./kbd": "./src/define/kbd.ts",
    "./elements": {
      "types": "./types/elements.d.ts"
    },
    "./react": {
      "types": "./types/react.d.ts"
    },
    "./preact": {
      "types": "./types/preact.d.ts"
    },
    "./solid": {
      "types": "./types/solid.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-data.json": "./vscode.html-data.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./icon": {
        "types": "./dist/define/icon.d.ts",
        "default": "./dist/define/icon.js"
      },
      "./kbd": {
        "types": "./dist/define/kbd.d.ts",
        "default": "./dist/define/kbd.js"
      },
      "./elements": {
        "types": "./types/elements.d.ts"
      },
      "./react": {
        "types": "./types/react.d.ts"
      },
      "./preact": {
        "types": "./types/preact.d.ts"
      },
      "./solid": {
        "types": "./types/solid.d.ts"
      },
      "./vue": {
        "types": "./types/vue.d.ts"
      },
      "./svelte": {
        "types": "./types/svelte.d.ts"
      },
      "./custom-elements.json": "./custom-elements.json",
      "./vscode.html-data.json": "./vscode.html-data.json"
    }
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "vscode.html-data.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate.ts"
  },
  "dependencies": {
    "@station/behaviors": "workspace:*",
    "@station/icons": "workspace:*",
    "@station/tokens": "workspace:*",
    "atomico": "^2.2.0"
  },
  "customElements": "custom-elements.json",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "preact": "^11.0.0",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@types/react": ">=19",
    "preact": ">=10",
    "solid-js": ">=1.8",
    "vue": ">=3.4",
    "svelte": ">=5"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
