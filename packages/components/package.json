    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@types/react": ">=19",
    "preact": ">=10",
    "solid-js": ">=1.8",
    "vue": ">=3.4",
    "svelte": ">=5"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
